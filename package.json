{
  "name": "wheelie-life-pr",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Wheelie Life PR \u2014 prototype. Calles, Bikes, Isla, Libertad.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sim": "esbuild tools/simcheck.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/simcheck.mjs --log-level=error && node node_modules/.cache/simcheck.mjs",
    "sim:all": "npm run sim --silent -- yz250f && node node_modules/.cache/simcheck.mjs streetfighter && node node_modules/.cache/simcheck.mjs grom",
    "check": "npm run typecheck && npm run build && npm run sim:all && npm run rivals && npm run scene && npm run edges",
    "deploy": "node tools/release.mjs",
    "beta": "npm run build && vite preview --host --port 4173",
    "deploy:live": "node tools/release.mjs --live",
    "rivals": "esbuild tools/rivalcheck.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/rivalcheck.mjs --log-level=error && node node_modules/.cache/rivalcheck.mjs",
    "scene": "esbuild tools/vehiclecheck.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/scenecheck.mjs --log-level=error && node node_modules/.cache/scenecheck.mjs",
    "edges": "esbuild tools/edgecheck.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/edgecheck.mjs --log-level=error && node node_modules/.cache/edgecheck.mjs"
  },
  "devDependencies": {
    "@types/three": "^0.169.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.6.3",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "lil-gui": "^0.19.2",
    "three": "^0.169.0"
  }
}
