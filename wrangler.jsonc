{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wheelie-life-pr",
  "compatibility_date": "2026-09-06",
  // Static-asset Worker: the built game is served straight from the edge, no
  // server code. This is the "live" build the Xbox browser loads.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": true }
}
